; Tiny Legends - one encounter proof of concept
; Import this project from Godot 4.4+.
config_version=5

[application]
config/name="Tiny Legends - Battle Lab"
run/main_scene="res://scenes/battle_screen.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.058824, 0.070588, 0.121569, 1)
